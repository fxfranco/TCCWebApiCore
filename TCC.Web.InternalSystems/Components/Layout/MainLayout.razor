@inherits LayoutComponentBase
@inject TCC.Web.InternalSystems.Services.AppStateServiceUser AppStateUser
@inject TCC.Web.InternalSystems.Services.AppStateServiceBPMS AppStateBPMS
@inject TCC.Web.InternalSystems.Services.AppStateServiceSIM AppStateSIM
@inject TCC.Web.InternalSystems.Services.AppStateServiceOpenComex AppStateOpenComex
@inject TCC.Web.InternalSystems.Services.AppStateServiceAsisComex AppStateAsisComex
@inject TCC.Web.InternalSystems.Services.AppStateServiceExternalCarrier AppStateExternalCarrier
@inject TCC.Web.InternalSystems.Services.AppStateServiceUsersSystem AppStateUsersSystem
@inject NavigationManager Navigation

<div class="page">
    @if (AppStateUser.IsAuthenticated)
    {
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                <span>Bienvenido, <b>@AppStateUser.Username</b></span>
                <button class="btn btn-link text-danger" @onclick="Logout">Cerrar Sesión</button>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    }
    else
    {
        <main class="d-flex align-items-center justify-content-center vh-100 bg-light">
            <TCC.Web.InternalSystems.Components.Pages.Login />
        </main>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        AppStateUser.PropertyChanged += (s, e) => StateHasChanged();
    }

    private void Logout()
    {
        AppStateUser.Logout();
        AppStateBPMS.Logout();
        AppStateSIM.Logout();
        AppStateOpenComex.Logout();
        AppStateAsisComex.Logout();
        AppStateExternalCarrier.Logout();
        AppStateUsersSystem.Logout();
        Navigation.NavigateTo("/");
    }
}